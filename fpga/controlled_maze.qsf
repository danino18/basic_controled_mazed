# Controlled Maze - Quartus Prime Lite 17.0 project settings
# Device and fast-compile settings follow the supplied Lab1Demo.qsf.

set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSXFC6D6F31C6
set_global_assignment -name TOP_LEVEL_ENTITY sound_arbiter
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 17.0.0
set_global_assignment -name LAST_QUARTUS_VERSION "17.1.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name SMART_RECOMPILE ON
# LogicLock licence notice, also disabled in the supplied Lab1Demo.qsf
set_global_assignment -name MESSAGE_DISABLE 292013
# Imported KBDINTF.qxp is a black box during synthesis (also disabled in Lab1Demo.qsf)
set_global_assignment -name MESSAGE_DISABLE 12240
set_global_assignment -name PHYSICAL_SYNTHESIS_EFFORT FAST
set_global_assignment -name FITTER_EFFORT FAST_FIT
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC OFF
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_DUPLICATION OFF
set_global_assignment -name PHYSICAL_SYNTHESIS_ASYNCHRONOUS_SIGNAL_PIPELINING OFF
# Hold repair stays on: the supplied project disables it, but back-to-back pipeline
# registers in the drawing layers otherwise fail hold by a few picoseconds.
set_global_assignment -name OPTIMIZE_HOLD_TIMING "ALL PATHS"
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"

# ---- supplied lab infrastructure (unmodified copies)
set_global_assignment -name QIP_FILE CLK_31P5.qip
set_global_assignment -name SIP_FILE CLK_31P5.sip
set_global_assignment -name SYSTEMVERILOG_FILE RTL/VGA/VGA_Controller.sv
set_global_assignment -name SYSTEMVERILOG_FILE RTL/VGA/square_object.sv
set_global_assignment -name SYSTEMVERILOG_FILE RTL/Seg7/SEG7.SV
set_global_assignment -name SYSTEMVERILOG_FILE RTL/AUDIO/SinTable.sv
set_global_assignment -name SYSTEMVERILOG_FILE RTL/AUDIO/ToneDecoder.sv
set_global_assignment -name SYSTEMVERILOG_FILE RTL/AUDIO/prescaler.sv
set_global_assignment -name SYSTEMVERILOG_FILE RTL/AUDIO/addr_counter.sv
set_global_assignment -name SYSTEMVERILOG_FILE RTL/AUDIO/Mili_sec_counter.sv
set_global_assignment -name SYSTEMVERILOG_FILE RTL/AUDIO/melody_player_1.sv
set_global_assignment -name QXP_FILE audio_codec_controller.QXP
set_global_assignment -name QXP_FILE KBDINTF.qxp
set_global_assignment -name VERILOG_FILE RTL/KEYBOARDX/kbd_wrapper.v
set_global_assignment -name SYSTEMVERILOG_FILE RTL/KEYBOARDX/singleKeyDecoder.sv
set_global_assignment -name SYSTEMVERILOG_FILE RTL/KEYBOARDX/random.sv
set_global_assignment -name SYSTEMVERILOG_FILE RTL/KEYBOARDX/KBD_Block.sv

# ---- project sources (packages first)
set_global_assignment -name SYSTEMVERILOG_FILE RTL/PKG/palette_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE RTL/PKG/game_params_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE RTL/PKG/game_state_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE RTL/PKG/text_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE RTL/COMMON/reset_sync.sv
set_global_assignment -name SYSTEMVERILOG_FILE RTL/COMMON/bcd_counter.sv
set_global_assignment -name SYSTEMVERILOG_FILE RTL/COMMON/leading_zero_blank.sv
set_global_assignment -name SYSTEMVERILOG_FILE RTL/COMMON/lfsr_rng.sv
