set_global_assignment -name BDF_FILE RTL/TOP/controlled_maze_top.bdf
set_global_assignment -name BDF_FILE RTL/DRAW/Bird_Block.bdf
set_global_assignment -name BDF_FILE RTL/DRAW/Coral_Block.bdf
set_global_assignment -name BDF_FILE RTL/KEYBOARDX/KBD_Block.bdf
set_global_assignment -name BDF_FILE RTL/GAME/Sound_Block.bdf
set_global_assignment -name BDF_FILE RTL/DRAW/hex_display_top.bdf

set_global_assignment -name SDC_FILE constraints/controlled_maze.sdc


set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top