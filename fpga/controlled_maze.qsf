set_global_assignment -name SYSTEMVERILOG_FILE RTL/DRAW/bird_anim.sv
set_global_assignment -name SYSTEMVERILOG_FILE RTL/DRAW/Bird_Block.sv
set_global_assignment -name SYSTEMVERILOG_FILE RTL/DRAW/coral_draw.sv
set_global_assignment -name SYSTEMVERILOG_FILE RTL/DRAW/Coral_Block.sv
